# Configuración de desarrollo. NO contiene secretos: la app es 100% local.
#
# Uso (opcional; sin este archivo la app corre con los valores por defecto):
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env

# Logging estructurado. Por defecto: activo en debug, apagado en release.
ENABLE_LOGS=true

# Cuántos assets procesa cada lote de sincronización (Fase 4).
SYNC_BATCH_SIZE=500
